  "devDependencies": {
    "@risk-tolerance/svelte-adapter-bun": "link:@risk-tolerance/svelte-adapter-bun",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
