{
  "name": "nginx",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run scripts/build.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
